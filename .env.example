# Salin menjadi .env lalu sesuaikan nilainya sebelum `docker compose up`.

# Port di host tempat aplikasi bisa dibuka (http://localhost:8080)
APP_PORT=8080

# Kredensial database. DB_PASS wajib diisi dengan password yang kuat.
DB_NAME=baroon_reptile
DB_USER=baroon
DB_PASS=

# true untuk menampilkan detail error (hanya untuk pengembangan)
APP_DEBUG=false
