# Baroon Reptile - Konfigurasi Apache

# Jangan tampilkan isi folder yang tidak punya index
Options -Indexes

# Tolak akses langsung ke file yang bukan untuk publik
<FilesMatch "\.(sql|md|env|ini|log|yml|yaml)$|^(Dockerfile|\.gitattributes|\.gitignore)$">
    Require all denied
</FilesMatch>

# Halaman error kustom (403.php, 404.php, 500.php) hanya bisa dipasang dengan
# path absolut dari document root, jadi diatur di konfigurasi server
# (lihat docker/apache.conf), bukan di sini.
